{
  "name": "gigsprofit",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "node server/index.js",
    "start:server": "node server/index.js",
    "postinstall": "./node_modules/.bin/prisma generate --schema server/prisma/schema.prisma",
    "test": "node --test server/tests/*.test.js",
    "lint": "node --check server/index.js && node --check server/services/profitService.js && node --check server/services/validationService.js",
    "prisma:generate": "./node_modules/.bin/prisma generate --schema server/prisma/schema.prisma",
    "prisma:migrate": "./node_modules/.bin/prisma migrate dev --schema server/prisma/schema.prisma",
    "prisma:migrate:deploy": "./node_modules/.bin/prisma migrate deploy --schema server/prisma/schema.prisma",
    "prisma:seed": "node server/prisma/seed.js",
    "prisma:studio": "./node_modules/.bin/prisma studio --schema server/prisma/schema.prisma"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "expo": "~51.0.0",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
    "expo-linear-gradient": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "prisma": "^5.22.0"
  },
  "private": true
}
